# Supabase (npm run db:status prints the local values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Premium subscriptions. Use test-mode keys (sk_test_…) while developing.
STRIPE_SECRET_KEY=
# From the webhook endpoint in the Stripe dashboard, or `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# Optional: a price you made yourself. Leave empty and a ¥500/month "TabeDog Premium" price is created on first checkout.
STRIPE_PRICE_ID=
# Optional: public URL Stripe should return to (defaults to the request origin).
NEXT_PUBLIC_APP_URL=

# Blog dashboard (/admin): comma-separated emails allowed to write posts. Defaults to OPERATOR.email in lib/seo.ts.
BLOG_ADMIN_EMAILS=

# Blog drafting agent (/admin/blog/agent): an Anthropic API key from console.anthropic.com.
# Web search must be enabled for the org in the Console (Settings → Privacy).
ANTHROPIC_API_KEY=
# Optional: default model (claude-opus-5-5 or claude-sonnet-5-5).
BLOG_AGENT_MODEL=
# Optional: adds general web image results to the photo search (rights unknown; flagged in the UI).
BRAVE_SEARCH_API_KEY=

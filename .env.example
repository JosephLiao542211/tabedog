# Supabase (npm run db:status prints the local values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — Premium subscriptions. Use test-mode keys (sk_test_…) while developing.
STRIPE_SECRET_KEY=
# From the webhook endpoint in the Stripe dashboard, or `stripe listen` locally.
STRIPE_WEBHOOK_SECRET=
# Optional: a price you made yourself. Leave empty and a ¥500/month "TabeDog Premium" price is created on first checkout.
STRIPE_PRICE_ID=
# Optional: public URL Stripe should return to (defaults to the request origin).
NEXT_PUBLIC_APP_URL=

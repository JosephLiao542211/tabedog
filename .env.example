# Supabase project URL and keys. For the local stack run `npm run db:start` and copy from `npm run db:status`.
# Hosted: Project Settings → API. The "publishable"/"secret" keys work in place of anon/service_role.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54531
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for the scrape cache table; never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=

